# Mẫu cấu hình nginx trên server (SSL) cho https://scada.plenmaiot.com
#
# QUAN TRỌNG: KHÔNG dùng cookie dtr_machine để proxy toàn bộ location /
# (sẽ nuốt Plenma SCADA + MIDA CNC). Chỉ proxy các path DTR bên dưới.
#
# DTR:
#   /dtr/sortmachine           → SPA list (Plenma)
#   /dtr/sortmachine/25231/... → Express gateway (shell + embed)
#   /dtr-p/1007/...            → port phụ PLC/stream

# Trong http { }:
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }

server {
    listen 443 ssl http2;
    server_name scada.plenmaiot.com;

    # ssl_certificate ...
    # ssl_certificate_key ...

    root /var/www/25057/25057_Offical/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:3000/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Trang quản lý DTR (SPA Plenma)
    location = /dtr/sortmachine {
        try_files /index.html =404;
    }
    location = /dtr/sortmachine/ {
        try_files /index.html =404;
    }

    # Máy DTR theo ID → Express (shell / embed / assets / socket.io dưới prefix)
    location ~ ^/dtr/sortmachine/[^/]+ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # Port phụ (1411, 1007, ...)
    location ^~ /dtr-p/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # Plenma SCADA + MIDA CNC + login — luôn SPA, không phụ thuộc cookie DTR
    location / {
        try_files $uri $uri/ /index.html;
    }
}
