# Mẫu cấu hình nginx trên server (SSL) cho https://scada.plenmaiot.com
#
# DTR dùng cookie dtr_machine:
#   /dtr/sortmachine/25231/online  → Express set cookie + 302 → /online
#   /online (có cookie)            → Express proxy → Tailscale máy 25231
# React Router thấy pathname /online giống truy cập trực tiếp :5173/online

# Trong http { }:
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }

server {
    listen 443 ssl http2;
    server_name scada.plenmaiot.com;

    # ssl_certificate ...
    # ssl_certificate_key ...

    root /var/www/25057/25057_Offical/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:3000/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Trang quản lý DTR (SPA) — xoá ngữ cảnh máy
    location = /dtr/sortmachine {
        try_files /index.html =404;
    }
    location = /dtr/sortmachine/ {
        try_files /index.html =404;
    }

    # Vào máy theo ID → Express (set cookie + redirect /online|/dashboard|/)
    location ~ ^/dtr/sortmachine/[^/]+ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # Port phụ trên máy sort (1411 API, 1007 PLC/stream, ...) qua HTTPS/WSS
    # ws://host:1007/plc/ws → wss://host/dtr-p/1007/plc/ws
    location ^~ /dtr-p/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # Có cookie dtr_machine → toàn bộ path còn lại qua Express gateway
    location @dtr_cookie_proxy {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        error_page 418 = @dtr_cookie_proxy;
        if ($cookie_dtr_machine != "") {
            return 418;
        }
        try_files $uri $uri/ /index.html;
    }
}
