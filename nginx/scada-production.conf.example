##
# Cấu hình Nginx hoàn chỉnh — scada.plenmaiot.com + s.plenmaiot.com
#
# 1) Trong /etc/nginx/nginx.conf → http { } phải có:
#
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }
#
# 2) Copy nội dung này vào sites-enabled (vd. /etc/nginx/sites-available/default)
# 3) sudo nginx -t && sudo systemctl reload nginx
# 4) Backend Express :3000 + frontend build tại root bên dưới
##

# ---------- HTTP → HTTPS (scada) ----------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name scada.plenmaiot.com www.scada.plenmaiot.com;
    return 301 https://$host$request_uri;
}

# ---------- HTTP proxy s.plenmaiot.com ----------
server {
    listen 80;
    listen [::]:80;
    server_name s.plenmaiot.com;

    location / {
        proxy_pass http://100.70.140.122;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# ---------- HTTPS s.plenmaiot.com (máy sort trực tiếp) ----------
server {
    listen 443 ssl;
    server_name s.plenmaiot.com;

    # Điền certificate của s.plenmaiot.com
    # ssl_certificate     /etc/letsencrypt/live/s.plenmaiot.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/s.plenmaiot.com/privkey.pem;

    location / {
        proxy_pass http://100.70.140.122;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Accept-Encoding "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect http://100.70.140.122/ https://s.plenmaiot.com/;

        gunzip on;
        sub_filter_once off;
        sub_filter_types *;
        sub_filter 'ws://' 'wss://';
        sub_filter 'ws:\/\/' 'wss:\/\/';
        sub_filter ':1411' '';
    }

    location /socket.io/ {
        proxy_pass http://100.70.140.122:1411;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}

# ---------- HTTPS scada.plenmaiot.com (Plenma + MIDA + DTR gateway) ----------
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name scada.plenmaiot.com www.scada.plenmaiot.com;

    root /var/www/25057/25057_Offical/frontend/dist;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/scada.plenmaiot.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scada.plenmaiot.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # API Plenma / MIDA
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        alias /var/www/25057/25057_Offical/backend/uploads/;
        autoindex off;
    }

    # DTR — trang danh sách (SPA Plenma)
    location = /dtr/sortmachine {
        try_files /index.html =404;
    }
    location = /dtr/sortmachine/ {
        try_files /index.html =404;
    }

    # DTR — từng máy → Express → Tailscale
    location ~ ^/dtr/sortmachine/[^/]+ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # DTR — port phụ (PLC / image stream / …)
    location ^~ /dtr-p/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # DTR iframe — pathname trần khớp React Router (không đụng / và /mida)
    location ~ ^/(dashboard|online|s|share|tools|autotrain|newbottle|productionorder|admin)(/|$) {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # DTR Socket.IO / stats (khi có cookie máy)
    location ^~ /socket.io/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location ^~ /stats {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # Plenma SCADA + MIDA CNC
    location / {
        try_files $uri $uri/ /index.html;
    }
}
